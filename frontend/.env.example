# Base URL of the FastAPI backend (no trailing slash).
# Local development: the backend listens on http://localhost:8000 by default
# (`uvicorn app.main:app --reload`, run from the backend/ directory).
# If left empty in a production build, the frontend calls its own origin
# (useful when a reverse proxy serves both under one domain).
VITE_API_BASE_URL=http://localhost:8000

# Development only. When the backend runs with OTP_DEV_MODE=true it returns the
# verification code in the request-otp response (`dev_otp`). Set this to "true"
# to show that code in a [DEV] banner during `npm run dev`. It has no effect in
# production builds (`npm run build`): the code is never displayed or stored.
VITE_SHOW_DEV_OTP=false

# Must match the backend's OTP_LENGTH setting (backend default: 6).
VITE_OTP_LENGTH=6
