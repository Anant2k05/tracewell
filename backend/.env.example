# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Local dev default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./osint_exposure.db
# Production example (Postgres):
# DATABASE_URL=postgresql+asyncpg://osint_user:changeme@postgres:5432/osint_exposure

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_DEFAULT_PER_MINUTE=30
RATE_LIMIT_SCAN_PER_HOUR=5

# --- OTP / email verification ---
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@osint-exposure.local

# --- External OSINT data sources ---
# Every collector is free and keyless (XposedOrNot, RDAP, crt.sh, Gravatar).
# GITHUB_TOKEN is optional: GitHub's search API is free with or without it,
# a token just raises the rate limit from 10/min to 30/min.
GITHUB_TOKEN=

# --- Collector tuning ---
COLLECTOR_TIMEOUT_SECONDS=10
COLLECTOR_MAX_RETRIES=2
